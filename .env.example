# Скопируй этот файл в .env и заполни.
# На App Platform эти же переменные задаются в панели (можно загрузить прямо этим файлом).

# Ключ Timeweb AI Gateway: панель Timeweb Cloud → ИИ-сервисы → AI Gateway → API-ключи
API_KEY=

# Адрес AI Gateway. Работает и с любым OpenAI-совместимым API (например, https://openrouter.ai/api/v1)
BASE_URL=https://api.timeweb.ai/v1

# ID модели: панель AI Gateway → вкладка «Подключение» (ID есть в примере кода)
MODEL=xai/grok-4.7

# Сколько модель думает перед ответом: low, medium или high. Grok с low отвечает быстрее.
# Не все модели понимают эту настройку: если модель ругается, оставь пустым
REASONING_EFFORT=low

# ID навыка из Яндекс Диалогов: вкладка «Тестирование» → поле skill_id в запросе.
# Если задан, сервер отвечает только твоему навыку, и чужие не потратят твои токены
ALICE_SKILL_ID=

# Характер ассистента: чем он должен быть и как отвечать.
# Если пусто, берётся инструкция по умолчанию из config.js
# Только одной строкой: перевод строки в переменную не вставить
SYSTEM_PROMPT=
